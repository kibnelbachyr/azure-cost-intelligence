# ─────────────────────────────────────────────────────────────────────────────
# Azure Identity
# Set USE_MANAGED_IDENTITY=true when running inside Azure (App Service, ACA, VM)
# and remove AZURE_CLIENT_SECRET. Omit AZURE_CLIENT_ID for system-assigned
# managed identity; set it to the user-assigned identity client ID otherwise.
# Tenant ID and secret are required only for explicit service-principal mode.
# ─────────────────────────────────────────────────────────────────────────────
AZURE_TENANT_ID=<your-tenant-id>
AZURE_SUBSCRIPTION_ID=<your-subscription-id>

# Service Principal credentials (only needed when USE_MANAGED_IDENTITY=false)
AZURE_CLIENT_ID=<your-service-principal-client-id>
AZURE_CLIENT_SECRET=<your-service-principal-client-secret>

# Set to true to use Managed Identity instead of a Service Principal
USE_MANAGED_IDENTITY=false

# ─────────────────────────────────────────────────────────────────────────────
# Azure AI Foundry
# Project endpoint from Foundry project home page (public Azure cloud).
# ─────────────────────────────────────────────────────────────────────────────
AZURE_AI_PROJECT_ENDPOINT=https://your-account.services.ai.azure.com/api/projects/your-project

# Model deployment name inside your AI Foundry project
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# ─────────────────────────────────────────────────────────────────────────────
# Cost Analysis defaults
# ─────────────────────────────────────────────────────────────────────────────
DEFAULT_COST_LOOKBACK_DAYS=30
TOP_COST_DRIVERS_LIMIT=10
